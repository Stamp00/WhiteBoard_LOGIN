# Kopiera till .env och fyll i
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/login_db?sslmode=require"
# Samma hemlighet i login-api och board-api, minst 32 tecken. Generera t.ex. med:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
PORT=3001
# Kommaseparerade origins som får anropa API:n, t.ex. https://people.arcada.fi
CORS_ORIGINS="*"
JWT_EXPIRES_IN="8h"
